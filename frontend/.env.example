# Copy to .env.local for local development. Never commit real secrets.
# Only NEXT_PUBLIC_* values reach the browser — never put API keys there.
# The Sarvam API key belongs ONLY in backend/.env (SARVAM_API_KEY), never in the frontend.

# Chat mode: "api" (default — real FastAPI + Sarvam backend) or "mock" (explicit opt-in:
# canned, clearly-labelled answers for UI work without a backend).
NEXT_PUBLIC_CHAT_MODE=api

# Leave empty to call the backend through this Next.js server (same origin, recommended):
# the browser calls /api/v1/* and Next.js proxies it to BACKEND_URL.
NEXT_PUBLIC_API_BASE_URL=

# Server-side only: where the Next.js server forwards /api/v1/* requests.
BACKEND_URL=http://127.0.0.1:8000
# Same server-only forwarding secret as Railway; never NEXT_PUBLIC_*.
# PROXY_SHARED_SECRET=

# Browser-side chat timeout in milliseconds (Sarvam-105B can take a while).
NEXT_PUBLIC_CHAT_TIMEOUT_MS=120000

# Admin authentication is handled entirely by FastAPI (Argon2id + server-side sessions).
# No admin credentials or flags belong in the frontend environment.
