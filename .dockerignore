# Build context = repository root. Allow-list: only what backend/Dockerfile copies.
*
!railway.toml
!backend/
backend/*
!backend/Dockerfile
!backend/requirements.lock
!backend/alembic.ini
!backend/migrations/
!backend/ingestion/
!backend/app/
!backend/scripts/start.sh
!backend/scripts/
backend/scripts/*
!backend/scripts/start.sh
!backend/scripts/sync.sh
!knowledge/
knowledge/*
!knowledge/deploy/
# Never, even if re-included above:
**/__pycache__
**/*.pyc
**/.env
**/.env.*
backend/data/
knowledge/raw/
knowledge/curated/
