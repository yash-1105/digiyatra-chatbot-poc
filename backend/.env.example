# Backend configuration. Copy to backend/.env for LOCAL development (chmod 600; git-ignored).
# In production (Railway) set these as service variables instead — never commit real values.
# Every value below is the default unless marked REQUIRED.

# --- Runtime mode --------------------------------------------------------------
# production => Secure cookies, no /api/docs, and start-up refuses insecure settings.
ENVIRONMENT=development
# Required in production while content approval is pending. Base64 of a private username:password.
# STAGING_BASIC_AUTH=
# Bind address used by scripts/start.sh (container default 0.0.0.0; use 127.0.0.1 on shared hosts).
# HOST=0.0.0.0
# PORT=8000                       # Railway injects PORT automatically

# --- Sarvam AI (REQUIRED for answers) --------------------------------------------
# Server-side only. Never put this in the frontend or any NEXT_PUBLIC_* variable.
SARVAM_API_KEY=
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TIMEOUT_S=35
# SARVAM_MAX_RETRIES=2
# SARVAM_MAX_TOKENS=1200
# none = fast; low/medium spend tokens on reasoning (counted in MAX_TOKENS — raise it if enabled)
# SARVAM_REASONING_EFFORT=none
# SARVAM_TEMPERATURE=0.2

# --- Database (analytics + admin) ------------------------------------------------
# Local default: SQLite file backend/data/app.db.
# Production (REQUIRED): PostgreSQL. Railway's postgres:// / postgresql:// URLs are accepted and
# normalised to postgresql+psycopg:// automatically.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# ALLOW_SQLITE_IN_PRODUCTION=false

# --- Admin authentication ----------------------------------------------------------
# Production (REQUIRED): the public frontend origin(s), JSON list, https only.
# ADMIN_ALLOWED_ORIGINS=["https://your-frontend.vercel.app"]
# ADMIN_SESSION_TTL_MINUTES=480     # absolute session lifetime
# ADMIN_SESSION_IDLE_MINUTES=60     # inactivity timeout
# ADMIN_LOGIN_MAX_FAILURES=5        # per email+IP per window
# ADMIN_LOGIN_WINDOW_MINUTES=15
# COOKIE_SECURE=                     # unset = automatic (true in production)
# Admin passwords are NEVER configured here: run `python -m app.cli create-admin`.

# --- Knowledge & index ------------------------------------------------------------
# The approved deployment corpus (only knowledge input in production).
# KNOWLEDGE_CORPUS_DIR=../knowledge/deploy        # container: /app/knowledge/deploy
# Rebuildable LanceDB index (mount a Railway volume here to skip rebuilds; optional).
# INDEX_DIR=./data/lancedb                        # container: /data/lancedb
# auto = Sarvam embeddinggemma-2 if the key has access, else lexical; lexical = deterministic TF-IDF
# (NOT neural embeddings). Production image defaults to lexical for deterministic rebuilds.
# EMBEDDING_PROVIDER=auto
# Local-only ingestion inputs (not used in production):
# KNOWLEDGE_RAW_DIR=../knowledge/raw
# KNOWLEDGE_CURATED_DIR=../knowledge/curated
# APPROVAL_MANIFEST=../knowledge/approval_manifest.json

# --- Retrieval ------------------------------------------------------------------------
# RETRIEVAL_TOP_K=5
# RETRIEVAL_CANDIDATES=30
# RETRIEVAL_MIN_SCORE=0.15
# RETRIEVAL_VECTOR_WEIGHT=0.45
# RETRIEVAL_MAX_PER_SOURCE=2

# --- API limits, CORS and proxies -------------------------------------------------------
# Browsers reach the API through the Next.js/Vercel same-origin proxy, so CORS can stay EMPTY in
# production: CORS_ORIGINS=[]
# CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW_S=60
# MAX_REQUEST_BYTES=16384
# Client IP for rate limiting. Local: trust X-Forwarded-For only from TRUSTED_PROXIES.
# Production uses signed Vercel client identities via PROXY_SHARED_SECRET, not hop-count assumptions.
# TRUSTED_PROXIES=["127.0.0.1","::1"]
# TRUSTED_PROXY_HOPS=0
# Production: shared server-only secret for authenticated Vercel client-IP forwarding.
# PROXY_SHARED_SECRET=

# --- Logging ------------------------------------------------------------------------------
# LOG_LEVEL=INFO
# Message text is NOT logged unless this is true (local debugging only — never in production).
# LOG_CHAT_CONTENT=false
